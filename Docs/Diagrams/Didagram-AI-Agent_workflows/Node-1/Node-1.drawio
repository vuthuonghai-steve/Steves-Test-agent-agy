<mxfile host="65bd71144e">
<diagram id="f1_pipeline_arch" name="1. Kiến Trúc Chuỗi Nơ-ron F1">
        <mxGraphModel dx="1400" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="1100" background="#ffffff" math="0" shadow="1">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="hdr1" value="&lt;b&gt;ĐẶC TẢ KIẾN TRÚC PHÂN RÃ SUB-NODES F1 CỦA NODE 1: PROBLEM DISCOVERY &amp;amp; GATE 1 ENGINE&lt;/b&gt;&lt;br/&gt;Chuỗi Nơ-ron Nhận Thức Tự Trị Phân Rã (SPEC-NODE1-F1-001) | SLA Toàn Trình p95 ≤ 15s | Vị Trí: n_input ➔ node1 ➔ gate1" style="rounded=1;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;align=center;html=1;fontSize=13;shadow=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="20" width="1320" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="n_stimulus" value="&lt;b&gt;KÍCH THÍCH ĐẦU VÀO THÔ (Raw Stimulus)&lt;/b&gt;&lt;br/&gt;Unstructured Text / Stack Traces / Complaints&lt;br/&gt;&lt;i&gt;Nhiều entropy, lẫn lộn triệu chứng và giải pháp vá víu, thiên kiến nhận thức&lt;/i&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="470" y="95" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_f11" value="&lt;b&gt;F1.1: Cognitive Sensory Ingestion &amp;amp; Lexical De-noiser (Tuần tự Tiền trạm)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Thalamic Sensory Gating&lt;/b&gt;: Tách S_fact, S_noise, S_func ➔ Đo lường SNR_semantic&lt;br/&gt;• &lt;b&gt;Premature Solution Quarantine&lt;/b&gt;: Cách ly giải pháp vá Monkey-patch (is_isolated=true)&lt;br/&gt;• &lt;b&gt;Canonical Entity Normalization&lt;/b&gt;: Chuẩn hoá thuật ngữ cục bộ, tiếng lóng, Code-switching En-Vi&lt;br/&gt;&lt;i&gt;Input: RawStimulusPayload ➔ Output: NormalizedStimulusContract | SLA ≤ 2.0s&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;align=left;spacingLeft=15;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="420" y="185" width="480" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n_f12" value="&lt;b&gt;F1.2: Dialectical Contradiction &amp;amp; Bias Arbiter (Tuần tự Phân xử)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Contradiction Detection Matrix (CDM)&lt;/b&gt;: Đối chiếu mâu thuẫn (CAP, PACELC, Amdahl)&lt;br/&gt;• &lt;b&gt;Khử 5 Thiên Kiến Nhận Thức&lt;/b&gt;: Sinh 3 Dialectical Counter-Hypotheses (chống Anchoring)&lt;br/&gt;• &lt;b&gt;Cowan 4-Slot Envelope&lt;/b&gt;: Đóng gói S0 (State gốc), ΔE (Kích thích), S_expected, ΔS (Lệch)&lt;br/&gt;&lt;i&gt;Input: NormalizedStimulusContract ➔ Output: DialecticalBiasContract | SLA ≤ 2.0s&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;align=left;spacingLeft=15;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="420" y="295" width="480" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="c_parallel" value="&lt;b&gt;CỤM GIẢI PHẪU NHẬN THỨC SONG SONG (Fan-out / Fan-in Concurrent Mesh)&lt;/b&gt; — SLA Chạy Đồng Thời ≤ 3.5s" style="swimlane;startSize=28;horizontal=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontColor=#5b21b6;fontSize=11;fontStyle=1;rounded=1;strokeWidth=2;pointerEvents=0;" vertex="1" parent="1">
                    <mxGeometry x="40" y="405" width="1240" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="n_f13" value="&lt;b&gt;F1.3: 5-Dimensional Cognitive Layering Engine&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Domain&lt;/b&gt;: Mục tiêu kinh doanh, giá trị đo lường&lt;br/&gt;• &lt;b&gt;Platform &amp;amp; OS&lt;/b&gt;: Windows STA/P-Invoke vs Linux epoll&lt;br/&gt;• &lt;b&gt;Causality DAG&lt;/b&gt;: 5-Whys tách biệt Triệu chứng &amp;amp; Căn nguyên&lt;br/&gt;• &lt;b&gt;Data &amp;amp; State&lt;/b&gt;: Aggregate boundary, ACID vs BASE&lt;br/&gt;• &lt;b&gt;Failure Blast Radius&lt;/b&gt;: Thread ➔ Process ➔ Data Corruption" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#5b21b6;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="c_parallel">
                    <mxGeometry x="20" y="40" width="380" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="n_f14" value="&lt;b&gt;F1.4: First Principles &amp;amp; Blindspot Excavator&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;First Principles Baseline&lt;/b&gt;: CPU cycles, IOPS, RTT, RAM&lt;br/&gt;• &lt;b&gt;Khai quật Unknown-Unknowns&lt;/b&gt;: Ma trận 8 chiều ẩn số&lt;br/&gt;  (Temporal, Concurrency, Tenant, Cloud Quota, Rollback...)&lt;br/&gt;• &lt;b&gt;Zero-Hallucination Tagging&lt;/b&gt;: Gán nhãn chặt chẽ:&lt;br/&gt;  - UNVERIFIED_ASSUMPTION (Độ tin cậy &amp;lt; 0.8)&lt;br/&gt;  - CRITICAL_CONTEXT_VOID (Ngữ cảnh sống còn BLOCKING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#5b21b6;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="c_parallel">
                    <mxGeometry x="430" y="40" width="380" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="n_f15" value="&lt;b&gt;F1.5: Negative Space &amp;amp; Anti-Pattern Grounder&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Không Gian Phủ Định&lt;/b&gt;: Thiết lập tối thiểu 3-5 điều CẤM LÀM&lt;br/&gt;  (Kèm lý giải kỹ thuật &amp;amp; cảnh báo hậu quả sập nguồn)&lt;br/&gt;• &lt;b&gt;Ranh giới phạm vi&lt;/b&gt;: Phân định In-Scope vs Out-of-Scope&lt;br/&gt;• &lt;b&gt;Anti-Pattern Grounding&lt;/b&gt;: Nhận diện và loại trừ:&lt;br/&gt;  - Watchdog Kill -9 Trap, Busy Waiting, Distributed Monolith&lt;br/&gt;  - Chống Premature Solutioning lọt vào định nghĩa bài toán" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#5b21b6;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="c_parallel">
                    <mxGeometry x="840" y="40" width="380" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="n_f16" value="&lt;b&gt;F1.6: Problem Dossier Compiler &amp;amp; Token Optimizer (Fan-in Synchronization Barrier)&lt;/b&gt;&lt;br/&gt;• Thu thập kết quả 3 nhánh song song F1.3, F1.4, F1.5 &amp;amp; Giải quyết xung đột chéo giữa các góc nhìn&lt;br/&gt;• &lt;b&gt;Tối ưu hoá Context Density&lt;/b&gt;: Nén bản tóm tắt xuống &amp;lt; 3,500 tokens (bảo tồn Context Window cho Node 2 &amp;amp; Node 3)&lt;br/&gt;• Đóng gói hợp đồng máy đọc &lt;b&gt;ProblemDossierContract&lt;/b&gt; &amp;amp; Kiểm chứng JSON AST Schema (exit code 0) | SLA ≤ 1.5s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#10b981;fontColor=#047857;fontSize=11;align=center;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="370" y="620" width="580" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="n_f17" value="&lt;b&gt;F1.7: GATE 1 Arbiter&lt;/b&gt;&lt;br/&gt;Scoping Score ≥ 85/100 &amp;amp;&lt;br/&gt;0 Critical Flaws?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#92400e;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="550" y="725" width="220" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="n_handoff" value="&lt;b&gt;CHUYỂN GIAO SANG NODE 2 (Business Analysis)&lt;/b&gt;&lt;br/&gt;Tiếp nhận ProblemDossierContract đạt chuẩn&lt;br/&gt;&lt;i&gt;Khởi động phân tích 4 tầng BABOK v3&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="450" y="855" width="270" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="n_socratic" value="&lt;b&gt;ADAPTIVE SOCRATIC DIAGNOSTIC MIRROR&lt;/b&gt;&lt;br/&gt;• Phản chiếu S0 &amp;amp; ΔS khách quan, chỉ rõ điểm mù&lt;br/&gt;• Cung cấp 3-4 lựa chọn kỹ thuật Multiple-Choice&lt;br/&gt;&lt;i&gt;Dev bấm chọn giải pháp thay vì gõ văn bản mơ hồ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#be123c;fontSize=10;strokeDasharray=3 3;strokeWidth=1.5;" vertex="1" parent="1">
                    <mxGeometry x="80" y="732.5" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n_provisional" value="&lt;b&gt;PROVISIONAL PASS (Chuyển giao có điều kiện)&lt;/b&gt;&lt;br/&gt;• Khóa Safe Default Assumptions để thông luồng pipeline&lt;br/&gt;• Gắn cờ cảnh báo HIGH_RISK_ASSUMPTIONS_CONTAINED&lt;br/&gt;• Bắn cảnh báo Lateral Synapse tới Tech Lead / Architect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#854d0e;fontSize=10;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="940" y="732.5" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n_lateral" value="&lt;b&gt;LATERAL TELEMETRY SYNAPSE&lt;/b&gt;&lt;br/&gt;Wide Event Logging (Serilog / Canonical Lines)&lt;br/&gt;TraceId, SNR Score, Quarantined Flags, Token Count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#b45309;fontSize=10;strokeDasharray=4 4;" vertex="1" parent="1">
                    <mxGeometry x="980" y="195" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_backprop" value="&lt;b&gt;n_backprop: BACKPROP ERROR SYNAPSE&lt;/b&gt;&lt;br/&gt;• Tiếp nhận Domain Contradiction từ Node 2&lt;br/&gt;• Điều phối hồi tiếp (Circuit Breaker L ≤ 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;fontColor=#9d174d;fontSize=10;strokeDasharray=4 4;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="770" y="855" width="280" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="n_esc" value="&lt;b&gt;Human Escalation / Circuit Breaker&lt;/b&gt;&lt;br/&gt;Ngắt khẩn cấp khi L &amp;gt; 2&lt;br/&gt;&lt;i&gt;Chuyển Tech Lead can thiệp&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#881337;strokeColor=#4c0519;fontColor=#ffffff;fontSize=9.5;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="1110" y="855" width="210" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="n_legend" value="&lt;b&gt;CHÚ GIẢI KIẾN TRÚC F1:&lt;/b&gt;  &lt;span style=&quot;color:#0284c7;&quot;&gt;■ Xử lý tuần tự (Serial)&lt;/span&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#7c3aed;&quot;&gt;■ Xử lý song song (Fan-out Cluster)&lt;/span&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#10b981;&quot;&gt;■ Hội tụ &amp;amp; Biên dịch (Fan-in Barrier)&lt;/span&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#d97706;&quot;&gt;◆ Chốt chặn nhị phân Gate 1&lt;/span&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#059669;&quot;&gt;■ Chuyển giao thành công&lt;/span&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#e11d48;&quot;&gt;■ Socratic Mirror (L ≤ 2)&lt;/span&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#ca8a04;&quot;&gt;■ Provisional Pass (L &amp;gt; 2)&lt;/span&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#db2777;&quot;&gt;■ Lan truyền ngược Backprop (L ≤ 2)&lt;/span&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#881337;&quot;&gt;■ Chốt ngắt khẩn cấp Escalation (L &amp;gt; 2)&lt;/span&gt;" style="rounded=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=9.5;align=center;html=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="945" width="1320" height="35" as="geometry"/>
                </mxCell>
