                <mxCell id="node_client_error" value="&lt;b&gt;Bắt lỗi Server (Catch Error)&lt;/b&gt;&lt;br/&gt;Xử lý mã lỗi HTTP 4xx / 5xx&lt;br/&gt;Set isLoading = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
