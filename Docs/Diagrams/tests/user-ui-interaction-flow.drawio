                <mxCell id="node_decision_backend" value="Xử lý&lt;br/&gt;thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontStyle=1;fontSize=12;shadow=1;" parent="1" vertex="1">
