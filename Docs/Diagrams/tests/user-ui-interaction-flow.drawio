                </mxCell>
                <mxCell id="node_client_update_state" value="&lt;b&gt;7. Cập nhật State &amp;amp; Store&lt;/b&gt;&lt;br/&gt;Cập nhật Redux/Zustand/Local State;&lt;br/&gt;Xóa cache cũ, set isLoading = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D97706;strokeWidth=2;fontColor=#0f172a;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
