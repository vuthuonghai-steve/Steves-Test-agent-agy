                </mxCell>
                <mxCell id="node_ui_toast_error" value="&lt;b&gt;Hiển thị Toast Thông Báo Lỗi&lt;/b&gt;&lt;br/&gt;Thông báo lỗi server cho người dùng&lt;br/&gt;Kích hoạt lại nút &amp;amp; giữ form input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
