                <mxCell id="node_ui_render_success" value="&lt;b&gt;8. Render Giao diện Mới&lt;/b&gt;&lt;br/&gt;Cập nhật DOM/UI, Toast thành công,&lt;br/&gt;hoặc chuyển hướng màn hình (Route)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#166534;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
