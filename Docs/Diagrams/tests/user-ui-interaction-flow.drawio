                <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 18px; color: #0F172A;&quot;&gt;LUỒNG TƯƠNG TÁC NGƯỜI DÙNG VỚI GIAO DIỆN NGƯỜI DÙNG (USER - UI INTERACTION FLOW)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;Mô hình quy trình khép kín 4 phân tầng: Người dùng - Lớp Giao diện (UI) - Xử lý Logic Client - Dịch vụ Máy chủ (Backend)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;shadow=1;align=center;" parent="1" vertex="1">
