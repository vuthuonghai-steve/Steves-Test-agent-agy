                <mxCell id="node_start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#ffffff;fontStyle=1;fontSize=14;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="130" y="165" width="160" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="node_user_action" value="&lt;b&gt;1. Người dùng thao tác&lt;/b&gt;&lt;br/&gt;Nhập dữ liệu form, click nút submit,&lt;br/&gt;chọn filter hoặc thao tác cử chỉ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284C7;strokeWidth=2;fontColor=#0f172a;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="90" y="245" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="node_ui_capture" value="&lt;b&gt;2. UI bắt sự kiện (Event)&lt;/b&gt;&lt;br/&gt;Lắng nghe onClick, onSubmit, onChange;&lt;br/&gt;Thực hiện event.preventDefault()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0f172a;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="245" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="node_client_validate" value="&lt;b&gt;3. Client-side Validation&lt;/b&gt;&lt;br/&gt;Kiểm tra required, format (email, regex),&lt;br/&gt;độ dài và ràng buộc giá trị hợp lệ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D97706;strokeWidth=2;fontColor=#0f172a;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="790" y="245" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="node_decision_valid" value="Dữ liệu&lt;br/&gt;hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#92400E;fontStyle=1;fontSize=12;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="840" y="340" width="140" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="node_ui_error_inline" value="&lt;b&gt;Hiển thị lỗi Client (Inline Error)&lt;/b&gt;&lt;br/&gt;Báo đỏ viền ô input, hiển thị tooltip&lt;br/&gt;&amp;amp; Auto-focus vào trường bị sai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="350" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="node_user_fix" value="&lt;b&gt;Người dùng sửa đổi dữ liệu&lt;/b&gt;&lt;br/&gt;Đọc chỉ dẫn lỗi trên giao diện&lt;br/&gt;&amp;amp; chỉnh sửa lại thông tin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#DC2626;strokeWidth=2;fontColor=#0f172a;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="90" y="350" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="node_client_loading" value="&lt;b&gt;4. Cập nhật trạng thái Chờ&lt;/b&gt;&lt;br/&gt;Set isLoading = true&lt;br/&gt;Chuẩn bị HTTP Request Payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D97706;strokeWidth=2;fontColor=#0f172a;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="790" y="465" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="node_ui_loading" value="&lt;b&gt;Phản hồi trạng thái (Feedback)&lt;/b&gt;&lt;br/&gt;Disable nút bấm (ngăn double submit)&lt;br/&gt;Hiển thị Spinner / Skeleton Loading" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#5B21B6;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="465" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="node_backend_receive" value="&lt;b&gt;5. Backend tiếp nhận Request&lt;/b&gt;&lt;br/&gt;Xác thực Bearer/Cookie Token&lt;br/&gt;&amp;amp; Kiểm tra phân quyền truy cập (RBAC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;fontColor=#0f172a;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1145" y="465" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="node_backend_process" value="&lt;b&gt;6. Xử lý Nghiệp vụ &amp;amp; CSDL&lt;/b&gt;&lt;br/&gt;Thực thi Business Logic&lt;br/&gt;Truy vấn / Ghi dữ liệu vào Database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;fontColor=#0f172a;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1145" y="565" width="240" height="60" as="geometry"/>
