                </mxCell>
                <mxCell id="node_backend_response_ok" value="&lt;b&gt;Phản hồi HTTP 200 / 201 OK&lt;/b&gt;&lt;br/&gt;Đóng gói kết quả payload JSON&lt;br/&gt;Gửi response về trình duyệt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=12;arcSize=10;shadow=1;" parent="1" vertex="1">
